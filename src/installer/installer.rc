1 ICON "../app/beaglesampler.ico"
2 RCDATA "../app/beagle_logo_256.png"

10 RCDATA "../../build/dist/BeagleSampler.exe"
11 RCDATA "../../build/dist/BeagleSampler.vst3"
12 RCDATA "../../build/dist/CLAP/BeagleSampler.clap"

1 24 "installer.manifest"

1 VERSIONINFO
FILEVERSION 1,0,15,0
PRODUCTVERSION 1,0,15,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "BeagleBoss"
            VALUE "FileDescription", "BeagleSampler Installer & Setup"
            VALUE "FileVersion", "1.0.15.0"
            VALUE "InternalName", "BeagleSampler_Setup"
            VALUE "OriginalFilename", "BeagleSampler_Setup.exe"
            VALUE "ProductName", "BeagleSampler Setup"
            VALUE "ProductVersion", "1.0.15.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
